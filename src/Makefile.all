# This makefile is designed to make just ONE of the libraries, but make it fast.
# It gets called once per variant, and the total time is still faster than using
# the incremental Makefile.
#
# Object files are written to $(OBJDIR), which the top-level Makefile sets to
# ../build/<variant>. Each variant MUST have its own object directory: if they
# all share one, the first variant's .o files look up-to-date to every variant
# after it, so they get re-archived unchanged and all six libraries come out
# byte-identical (libwayne-g.a with no debug info, libwayne-pg.a with no
# profiling, and so on) without anything reporting an error.

all:
	$(MAKE) -f Makefile.incremental all

# Default to the current directory so this Makefile still works standalone.
# The override handles 'OBJDIR=' being passed in empty, which would otherwise
# put objects at the filesystem root.
OBJDIR ?= .
ifeq ($(strip $(OBJDIR)),)
  override OBJDIR := .
endif

# The .o files that make up the library, named without any directory.
OBJ_NAMES=stream48.o longlong.o bitvec.o sets.o smallgraph-transitive.o misc.o dverk.o rkd78.o lsode.o ddriv2.o bsode.o ldbsode.o rk4.o rk4s.o rk12.o rk23.o stack.o event.o heap.o linked-list.o stats.o queue.o compressedInt.o Oalloc.o variable_leapfrog.o leapfrog.o htree.o avltree.o bintree.o eigen.o mem-debug.o smallgraph.o tinygraph.o graph.o combin.o matvec.o sorts.o heun_euler.o multisets.o dynarray.o raw_hashmap.o hash.o sim_anneal.o circ_buf.o #qrkd78.o iqrkd78.o llfile.o

# ...and the same list, placed inside this variant's object directory.
OBJS := $(addprefix $(OBJDIR)/,$(OBJ_NAMES))
DEPS := $(OBJS:.o=.d)

INCLUDE=-I../include
#LIB=$(HOME)/lib/libwayne.a

CFLAGS=$(INCLUDE)

$(LIBOUT): $(OBJS)
	if ar rcvu $(LIBOUT) $(OBJS); then :; else echo "Internal ranlib failed?; try without it" >&2; ar Srcvu $(LIBOUT) $(OBJS); fi

# An explicit recipe is required here: the built-in %.o rule cannot write its
# output into a different directory. -MMD -MP emits a .d file listing every
# header the source pulled in, which replaces (and widens) the old
# '%.o: %.c ../include/%.h' rule that only tracked the same-named header.
$(OBJDIR)/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

-include $(DEPS)

.PHONY: all
