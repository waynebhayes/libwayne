# Incremental build: recompile changed .c files for all built variants only.
# Run from libwayne/ via: make incremental
# Discovers which variants exist by looking for ../libwayne*.a files.
# Uses per-variant ../build/VARIANT/.cflags to know what flags to compile with.
# Stamps live in build/.stamps/ — no .o files are written to src/.

# Shared with Makefile.all; see that file. Keeping one list is what stops the
# incremental build from skipping files the full build compiles.
include Makefile.srcs

SRCS := $(LIBWAYNE_SRCS)

STAMP_DIR := ../build/.stamps
STAMPS := $(patsubst %.c,$(STAMP_DIR)/%.stamp,$(filter %.c,$(SRCS)))

INCLUDE=-I../include
CFLAGS=$(INCLUDE)

BUILT_VARIANTS := $(patsubst ../%.a,%,$(wildcard ../libwayne*.a))

all: mk-dirs $(STAMPS)

mk-dirs:
	@if [ -z "$(BUILT_VARIANTS)" ]; then \
	    echo "no libwayne*.a found -- run a full build first ('make -f Makefile.Jason all' one directory up)" >&2; \
	    exit 1; \
	fi
	@mkdir -p $(STAMP_DIR)
	@for V in $(BUILT_VARIANTS); do mkdir -p ../build/$$V; done

$(STAMP_DIR)/%.stamp: %.c
	@for V in $(BUILT_VARIANTS); do \
	    F=$$(cat ../build/$$V/.cflags 2>/dev/null || echo "-O2"); \
	    $(CC) $(CFLAGS) $$F -c -o ../build/$$V/$*.o $< && ar rcvu ../$$V.a ../build/$$V/$*.o & \
	done; \
	wait
	touch $@

.PHONY: all mk-dirs
